generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id String @id @default(uuid())

  destination  String
  created_at   DateTime @default(now())
  starts_at    DateTime
  ends_at      DateTime
  is_confirmed Boolean  @default(false)

  participants Participant[]
  activities Activity[] 
  links Links[]

  @@map("trips")
}

model Participant {
  id           String  @id @default(uuid())
  name         String?
  email        String
  is_confirmed Boolean @default(false)
  is_owner     Boolean @default(false)

  trip_id String
  trip    Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("participants")
}

model Activity {
  id        String   @id @default(uuid())
  title     String
  occurs_at DateTime

  trip_id String
  trip    Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Links {
  id    String @id @default(uuid())
  title String
  url   String

  trip_id String
  trip    Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("links")
}